{
  "manifest_version": 3,
  "name": "Uptime for Ramp side panel",
  "version": "0.1.0",
  "description": "Shows your local Uptime workspace beside the Ramp bill that is open. Reads only the address of Ramp tabs.",
  "key": "",
  "permissions": [
    "sidePanel"
  ],
  "host_permissions": [
    "https://demo.ramp.com/*"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Uptime beside this bill"
  }
}
