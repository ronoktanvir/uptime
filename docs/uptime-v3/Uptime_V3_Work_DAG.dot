  CP0 -> CP1;
  CP0 -> W0; CP0 -> W1;
  CP1 -> W2; CP1 -> W3; CP1 -> W4; CP1 -> W5; CP1 -> W6; CP1 -> W7;
  W1 -> CP2; W2 -> CP2; W5 -> CP2; W6 -> CP2;
  W3 -> CP3A; W2 -> CP3A; W5 -> CP3A;
  W4 -> CP3B; W5 -> CP3B;
  CP2 -> CP4; CP3A -> CP4; CP3B -> CP4; W7 -> CP4;
  CP4 -> W8; W0 -> W8; W8 -> CP5; CP5 -> CP6;
  { rank=same; W3; W4; W5; W6; W7; }
  { rank=same; CP3A; CP3B; }
